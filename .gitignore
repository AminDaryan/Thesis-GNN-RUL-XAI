# --- Data ---------------------------------------------------------------
# The NASA C-MAPSS files are not redistributed with this repository.
# See README.md, section "Getting the data".
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# The cited papers. Each one is kept on this computer in docs/references/, but
# many are publishers' copies that may not be passed on, so none is committed.
# docs/references/manifest.json records where each file came from and its
# checksum, and scripts/fetch_references.py downloads the free ones again.
docs/references/*
!docs/references/README.md
!docs/references/manifest.json

# --- Generated outputs --------------------------------------------------
# Training writes one directory per run under reports/, so these accumulate.
# The numbers that belong in the thesis are quoted in docs/ASSUMPTIONS.md and
# README.md instead, where they can be read without re-running anything.
reports/*
!reports/figures/
reports/figures/*
!reports/figures/.gitkeep
*.log

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

# --- Tooling ------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# --- Editors and operating systems --------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch files. A commit message written here once got committed itself.
*.tmp

# Scratch folders: page renders and text dumps of the paper made while checking
# it. Copies of the paper's pages must not be committed.
tmp/

# Claude Code's per-machine settings: the local preview server it starts for
# the documentation site, and permissions granted on this computer.
.claude/launch.json
.claude/settings.local.json

# --- Data ---------------------------------------------------------------
# The NASA C-MAPSS files are not redistributed with this repository.
# See README.md, section "Getting the data".
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# --- Generated outputs --------------------------------------------------
# Training writes one directory per run under reports/, so these accumulate.
# The numbers that belong in the thesis are quoted in docs/ASSUMPTIONS.md and
# README.md instead, where they can be read without re-running anything.
reports/*
!reports/figures/
reports/figures/*
!reports/figures/.gitkeep
*.log

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

# --- Tooling ------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# --- Editors and operating systems --------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch files. A commit message written here once got committed itself.
*.tmp

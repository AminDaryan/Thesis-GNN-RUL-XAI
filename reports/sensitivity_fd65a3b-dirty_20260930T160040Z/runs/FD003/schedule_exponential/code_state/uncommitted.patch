-def _describe_job_folder(path: Path) -> dict[str, Any] | None:
-    """One job an earlier server left behind, read from its folder."""
-    parts = path.name.split("_")
-    if len(parts) < 3:
-        return None
-    recorded: dict[str, Any] = {}
